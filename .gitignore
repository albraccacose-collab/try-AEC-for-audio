# ---------------------------------------------------------------- build output
# AEC3.sln writes everything (libs, pdb, ilk, exe, dll) into output/<Cfg>_<Plat>/
AEC3-master/output/
output/

# Android packaging: a second, near-duplicate copy of audio_processing/ plus the
# NDK build, ~9.7 MB. This project targets Windows only and the copy is never
# compiled or referenced here, so it is not published.
AEC3-master/android/

