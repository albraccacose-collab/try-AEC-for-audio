AecToolApp_2/bin/x64/Debug/aec_api.dll

# ---------------------------------------------------------------- generated audio
# tools/make_test_audio.ps1 regenerates the synthetic pair on demand, so the
# test wavs are not committed. They also collide by filename with third-party
# dataset files that must not be redistributed.
testdata/
*.wav

